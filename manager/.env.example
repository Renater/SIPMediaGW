# --- Manager ---

# Accounts live in the database (table manager_users), managed from Settings.
# On first start with an empty table, the `admin` account is created with
# this password, to be changed at the first sign-in.
MANAGER_DEFAULT_PASSWORD=manager123$
# Minimum password length (never less than 8).
PASSWORD_MIN_LENGTH=11

# Maximum lifetime of a session from sign-in, active or not (hours).
# Signing out also ends the other sessions of the same account.
MANAGER_SESSION_HOURS=10

# Signing secret for the session cookies. Required in production;
# empty = ephemeral secret, sessions do not survive a restart.
MANAGER_SESSION_SECRET=

# proxyAPI base URL, reached over HTTP by the back end only.
PROXYAPI_URL=http://127.0.0.1:80

# Public address of the proxyAPI, the one the browser opens (the "Control"
# button in Supervision). Behind a reverse proxy: its public name,
# e.g. https://visio.example.org. Empty = PROXYAPI_URL.
PROXYAPI_PUBLIC_URL=

# proxyAPI admin token (PROXY_ADMIN_TOKEN on the proxy side).
# Held here and only here: it never reaches the browser.
PROXYAPI_ADMIN_TOKEN=

# Listening port for `python app.py` only: the image and the compose files
# listen on 8200.
# MANAGER_PORT=8200

# Set to 1 only behind the optional TLS reverse proxy.
MANAGER_COOKIE_SECURE=0

# Service name, tagline, logo and tab icon, shown on the sign-in screen, the
# top bar and the browser tab (as brand.js does for interact).
# Logo and icon: file names in the brand/ folder (svg, png, jpg, webp, ico).
# Defaults are SIPMediaGW's, shipped with the repository; a deployment adds its
# own to brand/ (kept out of git) and names them here. Empty icon: the tab
# shows the logo.
MANAGER_BRAND_NAME=SIP Media Gateway Manager
MANAGER_BRAND_TAGLINE=
MANAGER_BRAND_LOGO=logo.svg
MANAGER_BRAND_FAVICON=favicon.svg

# --- Reporting database ---
# PostgreSQL instance (Homer's can be shared: dedicated database and role,
# see db/bootstrap.sql). Host: the address where PostgreSQL publishes its port.
DATABASE_URL=postgresql://gw_manager:CHANGE_ME@127.0.0.1:5432/gw_manager

# Token the gateways present on /ingest/calls. Empty = route closed.
INGEST_TOKEN=
# Maximum size of a pushed call history (bytes); 8 MB covers a whole day
# of samples.
INGEST_MAX_BODY_BYTES=8388608

# Automatic reload of the Python code (development): --reload
MANAGER_RELOAD=

# Log level (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# PostgreSQL connection pool size
DB_POOL_SIZE=5

# Maximum duration of an SQL statement, in milliseconds (0 = no limit).
# Beyond it the statement is cancelled and the route answers 503.
DB_STATEMENT_TIMEOUT_MS=30000

# Time zone of the reporting periods (IANA name)
TZ=Europe/Paris

# Pool sampling (gateway hours): period in seconds, 0 = disabled
POOL_SAMPLE_INTERVAL=60

# --- SIP trace (Homer) — optional ---
# Homer UI base URL, e.g. http://homer.example.org:8080
# Leave empty (or undeclared) when the deployment has no Homer:
# the "SIP trace" button is then never shown.
HOMER_BASE=
# URL format: v7 (JSON blob) or v11
HOMER_FLAVOR=v7
HOMER_PROFILE=1_call
# Capture retention in days; beyond it the button is hidden. 0 = no check.
HOMER_RETENTION_DAYS=0

# lab (default) or production. In production the process refuses to start
# without MANAGER_SESSION_SECRET and MANAGER_COOKIE_SECURE=1, instead of
# warning and carrying on with lab defaults.
MANAGER_ENV=lab

# Set to 1 when a reverse proxy is in front: the login throttle then keys on
# X-Forwarded-For instead of the proxy's own address. Leave unset otherwise,
# or a direct client could forge the header.
TRUST_PROXY=

# --- reverse proxy (production) ---
# Set both, or neither. TRUST_PROXY=1 makes the throttle key on the address
# the proxy appended to X-Forwarded-For; FORWARDED_ALLOW_IPS is the proxy's
# own address, the only peer uvicorn accepts those headers from.
# The proxy may be on another machine: FORWARDED_ALLOW_IPS is then its LAN
# address (e.g. 192.0.2.20). The header is believed from it only, so a
# host reaching the port directly cannot choose its own address.
# TRUST_PROXY=1
# FORWARDED_ALLOW_IPS=127.0.0.1

# docker-compose.prod.yml: host address where port 8200 is published.
# 127.0.0.1 (default) when the reverse proxy runs on this machine; the LAN
# address when it runs elsewhere or the gateways push here directly (firewall:
# 8200 open to the proxy and the gateways only).
# MANAGER_BIND=127.0.0.1
