# Kamailio variables (see kamailio/config/.env_cred for credentials)
PUBLIC_IP=${PUBLIC_IP:-$HOST_IP}
LOCAL_IP=${LOCAL_IP:-$HOST_IP}
# Comma separated domains, e.g. visio.numerique.gouv.fr,webconf.xxx.fr,bbb.numerique-esr.fr
SIP_DOMAIN=

HEPLIFY_SRV=${HEPLIFY_SRV:-$HOST_IP}
DEBUG_LEVEL=0 # 0 (warning), 1 (notice), 2 (info), 3 (debug)
ANTIFLOOD=True
TLS=True
